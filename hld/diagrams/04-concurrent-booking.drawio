<mxfile host="app.diagrams.net" agent="airline-assignment" type="device">
  <diagram id="concurrent-booking" name="Concurrent Booking">
    <mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Concurrency — Two Customers, One Seat" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Both transactions reach the INSERT. The partial unique index decides the winner — no row lock is taken on this path." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="950" height="20" as="geometry" />
        </mxCell>

        <mxCell id="llA" value="Customer A" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="90" width="150" height="640" as="geometry" />
        </mxCell>
        <mxCell id="llB" value="Customer B" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="215" y="90" width="150" height="640" as="geometry" />
        </mxCell>
        <mxCell id="llTxA" value="Transaction A&lt;br&gt;&lt;font style='font-size:9px'&gt;BookingService&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=45;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="420" y="90" width="170" height="640" as="geometry" />
        </mxCell>
        <mxCell id="llTxB" value="Transaction B&lt;br&gt;&lt;font style='font-size:9px'&gt;BookingService&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=45;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="640" y="90" width="170" height="640" as="geometry" />
        </mxCell>
        <mxCell id="llPg" value="PostgreSQL&lt;br&gt;&lt;font style='font-size:9px'&gt;ux_seat_active&lt;/font&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=45;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="900" y="90" width="170" height="640" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="POST /api/bookings  seats=[15A]" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="105" y="165" as="sourcePoint" />
            <mxPoint x="505" y="165" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c2" value="POST /api/bookings  seats=[15A]   (same instant)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="205" as="sourcePoint" />
            <mxPoint x="725" y="205" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c3" value="INSERT seat_assignment (instance, '15A') + flush()" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="505" y="265" as="sourcePoint" />
            <mxPoint x="985" y="265" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c4" value="INSERT seat_assignment (instance, '15A') + flush()" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="725" y="325" as="sourcePoint" />
            <mxPoint x="985" y="325" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="blockBar" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#b85450;opacity=60;" vertex="1" parent="1">
          <mxGeometry x="718" y="330" width="14" height="110" as="geometry" />
        </mxCell>
        <mxCell id="blockNote" value="Transaction B BLOCKS here on the index tuple&lt;br&gt;Transaction A holds. No application lock was&lt;br&gt;requested — Postgres serializes the two writers&lt;br&gt;on the unique index itself." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1110" y="330" width="330" height="70" as="geometry" />
        </mxCell>

        <mxCell id="c5" value="COMMIT" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;fontStyle=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="505" y="460" as="sourcePoint" />
            <mxPoint x="985" y="460" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c6" value="ERROR 23505  duplicate key value violates unique constraint 'ux_seat_active'" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="985" y="510" as="sourcePoint" />
            <mxPoint x="725" y="510" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c7" value="ROLLBACK — no booking, no passenger, no seat rows" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;dashed=1;strokeColor=#b85450;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="725" y="555" as="sourcePoint" />
            <mxPoint x="985" y="555" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c8" value="201 Created   pnr=7KQ4XZ  seats=[15A]" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;fontStyle=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="505" y="615" as="sourcePoint" />
            <mxPoint x="105" y="615" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c9" value="409 SEAT_UNAVAILABLE   details=['15A']" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;fontStyle=1" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="725" y="665" as="sourcePoint" />
            <mxPoint x="290" y="665" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="outcome" value="&lt;b&gt;Outcome, asserted by test&lt;/b&gt;&lt;br&gt;&lt;br&gt;20 threads claiming '15A' on one flight:&lt;br&gt;&amp;nbsp;&amp;nbsp;· exactly 1 success&lt;br&gt;&amp;nbsp;&amp;nbsp;· 19 x SeatUnavailableException to 409&lt;br&gt;&amp;nbsp;&amp;nbsp;· exactly 1 seat_assignment row in the table&lt;br&gt;&lt;br&gt;20 threads claiming 20 DISTINCT seats:&lt;br&gt;&amp;nbsp;&amp;nbsp;· 20 successes, 0 failures&lt;br&gt;&lt;br&gt;&lt;i&gt;The second case is what rules out SELECT FOR&lt;br&gt;UPDATE: a row-lock design passes the first test&lt;br&gt;but needlessly queues on the second.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1110" y="430" width="330" height="200" as="geometry" />
        </mxCell>

        <mxCell id="layers" value="&lt;b&gt;Five layers of the concurrency strategy&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Partial unique index ux_seat_active — unconditional, survives application bugs and horizontal scaling&lt;br&gt;2. One transaction per booking, all seats inserted in a single SORTED batch — all or none, no deadlocks&lt;br&gt;3. Fail-fast conflict mapping to 409 naming the lost seats — losers learn immediately instead of queueing&lt;br&gt;4. resolveOrCreate via ON CONFLICT DO NOTHING — concurrent first-bookers converge on one instance, lock-free&lt;br&gt;5. @Version on booking and flight_instance — guards status transitions (confirm, cancel) against lost updates" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="750" width="1040" height="125" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
