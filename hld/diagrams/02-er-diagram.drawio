<mxfile host="app.diagrams.net" agent="airline-assignment" type="device">
  <diagram id="er-diagram" name="ER Diagram">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Airline Ticketing System — Entity Relationship Diagram" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="PK = primary key · FK = foreign key · UK = unique · All timestamps are TIMESTAMPTZ in UTC" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="900" height="20" as="geometry" />
        </mxCell>

        <mxCell id="tAirport" value="&lt;b&gt;airport&lt;/b&gt;&lt;hr size='1'&gt;id — PK&lt;br&gt;iata_code — CHAR(3) UK&lt;br&gt;name&lt;br&gt;city&lt;br&gt;country" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="seedNote1" value="seeded, no CRUD" style="text;html=1;align=center;fontSize=9;fontColor=#999999;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="200" height="16" as="geometry" />
        </mxCell>

        <mxCell id="tAircraft" value="&lt;b&gt;aircraft&lt;/b&gt;&lt;hr size='1'&gt;id — PK&lt;br&gt;aircraft_code — UK&lt;br&gt;aircraft_type&lt;br&gt;row_count — INT&lt;br&gt;seat_letters — VARCHAR(12)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="capNote" value="capacity = row_count x length(seat_letters)&lt;br&gt;No seat rows are ever stored." style="text;html=1;align=center;fontSize=9;fontColor=#b85450;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="30" y="420" width="220" height="30" as="geometry" />
        </mxCell>

        <mxCell id="tUser" value="&lt;b&gt;app_user&lt;/b&gt;&lt;hr size='1'&gt;id — PK&lt;br&gt;username — UK&lt;br&gt;password_hash — BCrypt&lt;br&gt;role — ADMIN | CUSTOMER&lt;br&gt;created_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="490" width="200" height="120" as="geometry" />
        </mxCell>

        <mxCell id="tSchedule" value="&lt;b&gt;flight_schedule&lt;/b&gt;&lt;hr size='1'&gt;id — PK&lt;br&gt;flight_number — UK where active&lt;br&gt;source_airport_id — FK&lt;br&gt;destination_airport_id — FK&lt;br&gt;departure_time — TIME (UTC)&lt;br&gt;arrival_time — TIME (UTC)&lt;br&gt;arrival_day_offset — 0 | 1&lt;br&gt;aircraft_id — FK&lt;br&gt;days_of_operation — SMALLINT mask&lt;br&gt;valid_from · valid_to — DATE&lt;br&gt;active — BOOLEAN&lt;br&gt;created_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="100" width="250" height="215" as="geometry" />
        </mxCell>
        <mxCell id="maskNote" value="7-bit mask, bit 0 = Monday&lt;br&gt;SOURCE OF TRUTH for what flies" style="text;html=1;align=center;fontSize=9;fontColor=#6c8ebf;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="330" y="315" width="250" height="30" as="geometry" />
        </mxCell>

        <mxCell id="tInstance" value="&lt;b&gt;flight_instance&lt;/b&gt;&lt;hr size='1'&gt;id — PK&lt;br&gt;schedule_id — FK&lt;br&gt;flight_date — DATE&lt;br&gt;departure_at — TIMESTAMPTZ&lt;br&gt;arrival_at — TIMESTAMPTZ&lt;br&gt;status&lt;br&gt;version — optimistic lock&lt;br&gt;created_at&lt;hr size='1'&gt;&lt;font color='#b85450'&gt;UNIQUE (schedule_id, flight_date)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="390" width="250" height="180" as="geometry" />
        </mxCell>
        <mxCell id="lazyNote" value="CREATED LAZILY — only on first booking or hold.&lt;br&gt;Read paths never materialize a row.&lt;br&gt;The UNIQUE constraint makes concurrent&lt;br&gt;first-booking races converge on one row." style="text;html=1;align=center;fontSize=9;fontColor=#d79b00;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="320" y="570" width="270" height="48" as="geometry" />
        </mxCell>

        <mxCell id="tBooking" value="&lt;b&gt;booking&lt;/b&gt;&lt;hr size='1'&gt;id — PK&lt;br&gt;pnr — CHAR(6) UK&lt;br&gt;flight_instance_id — FK&lt;br&gt;status — HELD | CONFIRMED&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;| CANCELLED | EXPIRED&lt;br&gt;passenger_count&lt;br&gt;contact_name&lt;br&gt;created_by_user_id — FK&lt;br&gt;hold_expires_at&lt;br&gt;created_at · updated_at&lt;br&gt;version — optimistic lock" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="100" width="240" height="200" as="geometry" />
        </mxCell>
        <mxCell id="holdNote" value="A hold is a booking in HELD status,&lt;br&gt;not a separate entity — one lifecycle." style="text;html=1;align=center;fontSize=9;fontColor=#82b366;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="670" y="300" width="260" height="30" as="geometry" />
        </mxCell>

        <mxCell id="tPassenger" value="&lt;b&gt;passenger&lt;/b&gt;&lt;hr size='1'&gt;id — PK&lt;br&gt;booking_id — FK CASCADE&lt;br&gt;full_name&lt;br&gt;seat_label — what was SOLD" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="370" width="240" height="105" as="geometry" />
        </mxCell>
        <mxCell id="histNote" value="Survives cancellation — the historical record" style="text;html=1;align=center;fontSize=9;fontColor=#82b366;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="670" y="475" width="260" height="16" as="geometry" />
        </mxCell>

        <mxCell id="tSeat" value="&lt;b&gt;seat_assignment&lt;/b&gt;&lt;hr size='1'&gt;id — PK&lt;br&gt;flight_instance_id — FK&lt;br&gt;seat_label — VARCHAR(4)&lt;br&gt;booking_id — FK CASCADE&lt;br&gt;status — HELD | BOOKED&lt;br&gt;expires_at&lt;br&gt;created_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="540" width="240" height="150" as="geometry" />
        </mxCell>

        <mxCell id="idxNote" value="&lt;b&gt;ux_seat_active — THE GUARANTEE&lt;/b&gt;&lt;br&gt;&lt;br&gt;CREATE UNIQUE INDEX ux_seat_active&lt;br&gt;&amp;nbsp;&amp;nbsp;ON seat_assignment&lt;br&gt;&amp;nbsp;&amp;nbsp;(flight_instance_id, seat_label)&lt;br&gt;&amp;nbsp;&amp;nbsp;WHERE status IN ('HELD','BOOKED');&lt;br&gt;&lt;br&gt;LIVE INVENTORY ONLY. Cancellation and hold&lt;br&gt;expiry DELETE rows, which frees the seat through&lt;br&gt;the partial index with no status bookkeeping.&lt;br&gt;&lt;br&gt;Because the index covers HELD and BOOKED, the&lt;br&gt;HELD-to-BOOKED flip never frees the seat." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="960" y="455" width="190" height="235" as="geometry" />
        </mxCell>

        <mxCell id="r1" value="1 : N  source" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;fontSize=9;exitX=1;exitY=0.25;exitDx=0;exitDy=0;" edge="1" parent="1" source="tAirport" target="tSchedule">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="1 : N  destination" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;fontSize=9;exitX=1;exitY=0.75;exitDx=0;exitDy=0;" edge="1" parent="1" source="tAirport" target="tSchedule">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;fontSize=9;" edge="1" parent="1" source="tAircraft" target="tSchedule">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="1 : N   derived lazily" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;fontSize=9;strokeColor=#d79b00;strokeWidth=2;dashed=1;" edge="1" parent="1" source="tSchedule" target="tInstance">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;fontSize=9;" edge="1" parent="1" source="tInstance" target="tBooking">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;fontSize=9;" edge="1" parent="1" source="tBooking" target="tPassenger">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r7" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;fontSize=9;" edge="1" parent="1" source="tPassenger" target="tSeat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r8" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;fontSize=9;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="tInstance" target="tSeat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r9" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERone;startFill=0;endFill=0;fontSize=9;dashed=1;" edge="1" parent="1" source="tUser" target="tBooking">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#d6b656;strokeWidth=2;" edge="1" parent="1" source="idxNote" target="tSeat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
