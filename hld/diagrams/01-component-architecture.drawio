          <mxGeometry x="260" y="80" width="780" height="80" as="geometry" />
        </mxCell>
        <mxCell id="grpCtl" value="controllers — bind and validate DTOs only, no transactions" style="rounded=0;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=8;fontSize=10;fontColor=#666666;" vertex="1" parent="1">
