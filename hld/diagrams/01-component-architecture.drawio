        <mxCell id="title" value="Airline Ticketing System — Component Architecture" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Strict one-direction layering: controller to service to repository. Services are the only transaction boundary." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="900" height="20" as="geometry" />
