        <mxCell id="pgNote" value="ux_seat_active — PARTIAL UNIQUE INDEX&lt;br&gt;(flight_instance_id, seat_label)&lt;br&gt;WHERE status IN ('HELD','BOOKED')&lt;br&gt;&lt;br&gt;&lt;i&gt;Double booking is impossible at the storage layer,&lt;br&gt;independent of application correctness.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
