<mxfile host="app.diagrams.net" agent="airline-assignment" type="device">
  <diagram id="booking-sequence" name="Booking Sequence">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Booking Request Flow — POST /api/bookings" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Labels of the form A / B show the success path and the conflict path through the same code." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="900" height="20" as="geometry" />
        </mxCell>

        <mxCell id="txBox" value="one @Transactional boundary — validation through seat insert. Any failure rolls back whole; a partial booking is impossible." style="rounded=0;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#b85450;verticalAlign=bottom;align=center;fontSize=10;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="440" y="215" width="790" height="500" as="geometry" />
        </mxCell>

        <mxCell id="llCustomer" value="Customer" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="25" y="90" width="170" height="700" as="geometry" />
        </mxCell>
        <mxCell id="llController" value="BookingController" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="215" y="90" width="170" height="700" as="geometry" />
        </mxCell>
        <mxCell id="llService" value="BookingService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="425" y="90" width="170" height="700" as="geometry" />
        </mxCell>
        <mxCell id="llResolver" value="FlightInstanceResolver" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="645" y="90" width="170" height="700" as="geometry" />
        </mxCell>
        <mxCell id="llClaim" value="SeatClaimService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="855" y="90" width="170" height="700" as="geometry" />
        </mxCell>
        <mxCell id="llPg" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=40;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1055" y="90" width="170" height="700" as="geometry" />
        </mxCell>

        <mxCell id="m1" value="POST /api/bookings" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="110" y="165" as="sourcePoint" />
            <mxPoint x="300" y="165" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2" value="create(request, userId)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="205" as="sourcePoint" />
            <mxPoint x="510" y="205" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" value="validate — 9 ordered checks" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=10;rounded=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="250" as="sourcePoint" />
            <mxPoint x="510" y="282" as="targetPoint" />
            <Array as="points">
              <mxPoint x="600" y="250" />
              <mxPoint x="600" y="282" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="m4" value="resolveOrCreate(schedule, date)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#d79b00;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="305" as="sourcePoint" />
            <mxPoint x="730" y="305" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="INSERT flight_instance ... ON CONFLICT (schedule_id, flight_date) DO NOTHING" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#d79b00;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="345" as="sourcePoint" />
            <mxPoint x="1140" y="345" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m6" value="SELECT — always finds a row" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#999999;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1140" y="385" as="sourcePoint" />
            <mxPoint x="730" y="385" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m7" value="FlightInstance" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#999999;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="730" y="425" as="sourcePoint" />
            <mxPoint x="510" y="425" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m8" value="DELETE lapsed HELD assignments for this instance" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="465" as="sourcePoint" />
            <mxPoint x="1140" y="465" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m9" value="INSERT booking (CONFIRMED, pnr) + passenger rows" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="505" as="sourcePoint" />
            <mxPoint x="1140" y="505" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m10" value="claimSeats(instance, booking, SORTED labels, BOOKED, null)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=2;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="545" as="sourcePoint" />
            <mxPoint x="940" y="545" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m11" value="INSERT seat_assignment x N   then   entityManager.flush()" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=2;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="940" y="585" as="sourcePoint" />
            <mxPoint x="1140" y="585" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m12" value="OK   /   unique violation on ux_seat_active" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#b85450;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1140" y="625" as="sourcePoint" />
            <mxPoint x="940" y="625" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m13" value="List&amp;lt;SeatAssignment&amp;gt;   /   SeatUnavailableException(details=[12A])" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#999999;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="940" y="665" as="sourcePoint" />
            <mxPoint x="510" y="665" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m14" value="BookingResponse   /   DomainException" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#999999;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="730" as="sourcePoint" />
            <mxPoint x="300" y="730" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m15" value="201 Created   /   409 SEAT_UNAVAILABLE + details[]" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;strokeColor=#999999;fontSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="300" y="770" as="sourcePoint" />
            <mxPoint x="110" y="770" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="noteValidate" value="&lt;b&gt;Validation order matters&lt;/b&gt;&lt;br&gt;1. active schedule by flight number — 404&lt;br&gt;2. date within [today, today+365] — 422&lt;br&gt;3. day-of-week in mask, date in validity — 422&lt;br&gt;4. departure not already past — 422&lt;br&gt;5. normalize labels, uppercase and trim — 400&lt;br&gt;6. labels valid for aircraft geometry — 400&lt;br&gt;7. no duplicate label in request — 400&lt;br&gt;8. seat count within 1..max-seats — 400&lt;br&gt;9. passenger count equals seat count — 400&lt;br&gt;&lt;br&gt;&lt;i&gt;Nothing is written until all nine pass.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1260" y="215" width="310" height="175" as="geometry" />
        </mxCell>
        <mxCell id="noteFlush" value="&lt;b&gt;Why the explicit flush()&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hibernate flushes at commit by default, and commit&lt;br&gt;happens OUTSIDE the service method. Without an&lt;br&gt;explicit flush inside the try block, the constraint&lt;br&gt;violation escapes the catch and surfaces after the&lt;br&gt;method returns — rendering 500 instead of 409.&lt;br&gt;&lt;br&gt;Flushing forces the INSERT to hit Postgres while&lt;br&gt;the exception is still catchable. The constraint&lt;br&gt;name is then read from PSQLException via&lt;br&gt;getServerErrorMessage().getConstraint() and&lt;br&gt;compared against 'ux_seat_active'." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1260" y="520" width="310" height="195" as="geometry" />
        </mxCell>
        <mxCell id="noteSort" value="&lt;b&gt;Why labels are sorted&lt;/b&gt;&lt;br&gt;Concurrent transactions claiming overlapping seat&lt;br&gt;sets in differing orders deadlock on index tuples.&lt;br&gt;Sorting gives every transaction the same&lt;br&gt;acquisition order, removing that failure class." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1260" y="420" width="310" height="80" as="geometry" />
        </mxCell>

        <mxCell id="cn1" style="html=1;endArrow=none;dashed=1;strokeColor=#82b366;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1260" y="265" as="sourcePoint" />
            <mxPoint x="610" y="265" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="cn2" style="html=1;endArrow=none;dashed=1;strokeColor=#d79b00;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1260" y="455" as="sourcePoint" />
            <mxPoint x="940" y="545" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="cn3" style="html=1;endArrow=none;dashed=1;strokeColor=#b85450;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1260" y="585" as="sourcePoint" />
            <mxPoint x="1140" y="585" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
